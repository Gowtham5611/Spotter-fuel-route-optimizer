# Django settings
DEBUG=True
SECRET_KEY=your-secret-key-here-replace-in-production

# External API configuration
ROUTING_API_BASE_URL=http://router.project-osrm.org
GEOCODING_API_BASE_URL=https://nominatim.openstreetmap.org

# Fuel / routing configuration
FUEL_ROUTE_CORRIDOR_MILES=15
MAX_RANGE_MILES=500
FUEL_EFFICIENCY_MPG=10

# External API timeout (seconds)
EXTERNAL_API_TIMEOUT=30

# CORS - comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Caching: directory for local cache files
CACHE_DIR=../data/cache
