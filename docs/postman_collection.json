					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"start\": \"New York, NY\",\n  \"destination\": \"Chicago, IL\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/routes/optimize/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"routes",
						"optimize",
						""
					]
				},
				"description": "Standard long-haul test route (~790 miles) requiring 1 fuel stop with 500-mile max range."
			},
			"response": []
		},
