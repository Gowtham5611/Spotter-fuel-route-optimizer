{
	"info": {
		"_postman_id": "spotter-fuel-route-api-collection",
		"name": "Spotter Fuel Route Optimizer API",
		"description": "Postman collection for testing the Spotter Fuel Route Optimizer REST API endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/v1/health/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"health",
						""
					]
				},
				"description": "Verifies that the backend API service is running and healthy."
			},
			"response": []
		},
		{
			"name": "Get Configuration",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/v1/config/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"config",
						""
					]
				},
				"description": "Retrieves the active configuration constants (max range, MPG, corridor distance, etc.)."
			},
			"response": []
		},
		{
